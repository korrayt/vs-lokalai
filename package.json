{
  "name": "vs-lokalai",
  "displayName": "VS LokalAI - Local AI Code Assistant",
  "description": "Privacy-first, zero-cloud local AI assistant for VS Code powered by Ollama, LM Studio, and LocalAI.",
  "version": "0.1.0",
  "publisher": "korrayt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "local-ai",
    "ollama",
    "lm-studio",
    "copilot",
    "offline-ai",
    "code-assistant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-lokalai.openChat",
        "title": "VS LokalAI: Open Local Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vs-lokalai.explainSelection",
        "title": "VS LokalAI: Explain Selected Code"
      },
      {
        "command": "vs-lokalai.refactorSelection",
        "title": "VS LokalAI: Refactor Selected Code"
      },
      {
        "command": "vs-lokalai.generateTests",
        "title": "VS LokalAI: Generate Unit Tests"
      },
      {
        "command": "vs-lokalai.indexWorkspace",
        "title": "VS LokalAI: Index Workspace Memory"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vs-lokalai-sidebar",
          "title": "VS LokalAI",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "vs-lokalai-sidebar": [
        {
          "type": "webview",
          "id": "vs-lokalai.chatView",
          "name": "Local Assistant"
        }
      ]
    },
    "configuration": {
      "title": "VS LokalAI",
      "properties": {
        "vsLokalAI.provider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "lm-studio",
            "localai",
            "custom-openai-compatible"
          ],
          "description": "Local AI backend provider to connect to."
        },
        "vsLokalAI.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "HTTP endpoint URL for the local AI provider."
        },
        "vsLokalAI.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Name of the local model to use (e.g. qwen2.5-coder:7b, deepseek-coder:6.7b, mistral, llama3.2)."
        },
        "vsLokalAI.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Sampling temperature for code completions."
        },
        "vsLokalAI.enableWorkspaceMemory": {
          "type": "boolean",
          "default": true,
          "description": "Automatically gather local code symbols and context from current workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
